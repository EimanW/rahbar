{
    "kind":  "Job",
    "apiVersion":  "batch/v1",
    "metadata":  {
                     "name":  "a3-clone-collection",
                     "namespace":  "rahbar",
                     "annotations":  {
                                         "cronjob.kubernetes.io/instantiate":  "manual"
                                     },
                     "ownerReferences":  [
                                             {
                                                 "apiVersion":  "batch/v1",
                                                 "kind":  "CronJob",
                                                 "name":  "reindex",
                                                 "uid":  "8e979a17-b295-4046-8a71-4dc9a28213f0",
                                                 "controller":  true
                                             }
                                         ]
                 },
    "spec":  {
                 "activeDeadlineSeconds":  1800,
                 "backoffLimit":  0,
                 "template":  {
                                  "metadata":  {
                                                   "labels":  {
                                                                  "app":  "indexer",
                                                                  "app.kubernetes.io/part-of":  "rahbar"
                                                              }
                                               },
                                  "spec":  {
                                               "volumes":  [
                                                               {
                                                                   "name":  "data-lake",
                                                                   "persistentVolumeClaim":  {
                                                                                                 "claimName":  "rahbar-data-lake"
                                                                                             }
                                                               },
                                                               {
                                                                   "name":  "tmp",
                                                                   "emptyDir":  {

                                                                                }
                                                               }
                                                           ],
                                               "initContainers":  [
                                                                      {
                                                                          "name":  "wait-for-chroma",
                                                                          "image":  "rahbar-indexer:dev",
                                                                          "command":  [
                                                                                          "python",
                                                                                          "-c"
                                                                                      ],
                                                                          "args":  [
                                                                                       "import os, time, httpx\nurl = f\"http://{os.environ[\u0027CHROMA_HOST\u0027]}:{os.environ[\u0027CHROMA_PORT\u0027]}/api/v2/heartbeat\"\nfor _ in range(150):\n    try:\n        httpx.get(url, timeout=2).raise_for_status(); print(\"chroma is up\"); break\n    except Exception as exc:\n        print(\"waiting for chroma:\", type(exc).__name__, flush=True); time.sleep(2)\nelse:\n    raise SystemExit(\"chroma never became reachable\")\n"
                                                                                   ],
                                                                          "envFrom":  [
                                                                                          {
                                                                                              "configMapRef":  {
                                                                                                                   "name":  "rahbar-config"
                                                                                                               }
                                                                                          }
                                                                                      ],
                                                                          "resources":  {
                                                                                            "limits":  {
                                                                                                           "cpu":  "100m",
                                                                                                           "memory":  "64Mi"
                                                                                                       },
                                                                                            "requests":  {
                                                                                                             "cpu":  "10m",
                                                                                                             "memory":  "32Mi"
                                                                                                         }
                                                                                        },
                                                                          "terminationMessagePath":  "/dev/termination-log",
                                                                          "terminationMessagePolicy":  "File",
                                                                          "imagePullPolicy":  "IfNotPresent",
                                                                          "securityContext":  {
                                                                                                  "capabilities":  {
                                                                                                                       "drop":  [
                                                                                                                                    "ALL"
                                                                                                                                ]
                                                                                                                   },
                                                                                                  "readOnlyRootFilesystem":  true,
                                                                                                  "allowPrivilegeEscalation":  false
                                                                                              }
                                                                      }
                                                                  ],
                                               "containers":  [
                                                                  {
                                                                      "name":  "indexer",
                                                                      "image":  "rahbar-indexer:a3",
                                                                      "envFrom":  [
                                                                                      {
                                                                                          "configMapRef":  {
                                                                                                               "name":  "rahbar-config"
                                                                                                           }
                                                                                      }
                                                                                  ],
                                                                      "env":  [
                                                                                  {
                                                                                      "name":  "DATA_LAKE",
                                                                                      "value":  "/data-lake"
                                                                                  }
                                                                              ],
                                                                      "resources":  {
                                                                                        "limits":  {
                                                                                                       "cpu":  "1",
                                                                                                       "memory":  "1536Mi"
                                                                                                   },
                                                                                        "requests":  {
                                                                                                         "cpu":  "250m",
                                                                                                         "memory":  "512Mi"
                                                                                                     }
                                                                                    },
                                                                      "volumeMounts":  [
                                                                                           {
                                                                                               "name":  "data-lake",
                                                                                               "mountPath":  "/data-lake"
                                                                                           },
                                                                                           {
                                                                                               "name":  "tmp",
                                                                                               "mountPath":  "/tmp"
                                                                                           }
                                                                                       ],
                                                                      "terminationMessagePath":  "/dev/termination-log",
                                                                      "terminationMessagePolicy":  "File",
                                                                      "imagePullPolicy":  "IfNotPresent",
                                                                      "securityContext":  {
                                                                                              "capabilities":  {
                                                                                                                   "drop":  [
                                                                                                                                "ALL"
                                                                                                                            ]
                                                                                                               },
                                                                                              "readOnlyRootFilesystem":  true,
                                                                                              "allowPrivilegeEscalation":  false
                                                                                          },
                                                                      "command":  [
                                                                                      "python",
                                                                                      "-c"
                                                                                  ]
                                                                  }
                                                              ],
                                               "restartPolicy":  "Never",
                                               "terminationGracePeriodSeconds":  30,
                                               "dnsPolicy":  "ClusterFirst",
                                               "serviceAccountName":  "rahbar-indexer",
                                               "serviceAccount":  "rahbar-indexer",
                                               "automountServiceAccountToken":  false,
                                               "securityContext":  {
                                                                       "runAsUser":  10001,
                                                                       "runAsGroup":  10001,
                                                                       "runAsNonRoot":  true,
                                                                       "fsGroup":  10001,
                                                                       "seccompProfile":  {
                                                                                              "type":  "RuntimeDefault"
                                                                                          }
                                                                   },
                                               "schedulerName":  "default-scheduler",
                                               "enableServiceLinks":  false
                                           }
                              }
             },
    "status":  {

               }
}

{
    "apiVersion":  "apps/v1",
    "kind":  "Deployment",
    "metadata":  {
                     "labels":  {
                                    "app":  "api-candidate"
                                },
                     "name":  "api-candidate",
                     "namespace":  "rahbar"
                 },
    "spec":  {
                 "progressDeadlineSeconds":  600,
                 "replicas":  1,
                 "revisionHistoryLimit":  5,
                 "selector":  {
                                  "matchLabels":  {
                                                      "app":  "api-candidate"
                                                  }
                              },
                 "strategy":  {
                                  "rollingUpdate":  {
                                                        "maxSurge":  1,
                                                        "maxUnavailable":  0
                                                    },
                                  "type":  "RollingUpdate"
                              },
                 "template":  {
                                  "metadata":  {
                                                   "labels":  {
                                                                  "app":  "api-candidate",
                                                                  "app.kubernetes.io/part-of":  "rahbar"
                                                              }
                                               },
                                  "spec":  {
                                               "automountServiceAccountToken":  false,
                                               "containers":  [
                                                                  {
                                                                      "env":  [
                                                                                  {
                                                                                      "name":  "LLM_API_KEY",
                                                                                      "valueFrom":  {
                                                                                                        "secretKeyRef":  {
                                                                                                                             "key":  "LLM_API_KEY",
                                                                                                                             "name":  "rahbar-secret",
                                                                                                                             "optional":  true
                                                                                                                         }
                                                                                                    }
                                                                                  },
                                                                                  {
                                                                                      "value":  "0.30",
                                                                                      "name":  "RELEVANCE_FLOOR"
                                                                                  },
                                                                                  {
                                                                                      "value":  "rahbar-a3",
                                                                                      "name":  "CHROMA_COLLECTION"
                                                                                  },
                                                                                  {
                                                                                      "value":  "/traces/candidate.jsonl",
                                                                                      "name":  "TRACE_FILE"
                                                                                  }
                                                                              ],
                                                                      "envFrom":  [
                                                                                      {
                                                                                          "configMapRef":  {
                                                                                                               "name":  "rahbar-config"
                                                                                                           }
                                                                                      }
                                                                                  ],
                                                                      "image":  "rahbar-api:dev",
                                                                      "imagePullPolicy":  "IfNotPresent",
                                                                      "lifecycle":  {
                                                                                        "preStop":  {
                                                                                                        "exec":  {
                                                                                                                     "command":  [
                                                                                                                                     "sleep",
                                                                                                                                     "5"
                                                                                                                                 ]
                                                                                                                 }
                                                                                                    }
                                                                                    },
                                                                      "livenessProbe":  {
                                                                                            "failureThreshold":  3,
                                                                                            "httpGet":  {
                                                                                                            "path":  "/healthz",
                                                                                                            "port":  8000,
                                                                                                            "scheme":  "HTTP"
                                                                                                        },
                                                                                            "periodSeconds":  20,
                                                                                            "successThreshold":  1,
                                                                                            "timeoutSeconds":  1
                                                                                        },
                                                                      "name":  "api",
                                                                      "ports":  [
                                                                                    {
                                                                                        "containerPort":  8000,
                                                                                        "name":  "http",
                                                                                        "protocol":  "TCP"
                                                                                    }
                                                                                ],
                                                                      "readinessProbe":  {
                                                                                             "failureThreshold":  3,
                                                                                             "httpGet":  {
                                                                                                             "path":  "/readyz",
                                                                                                             "port":  8000,
                                                                                                             "scheme":  "HTTP"
                                                                                                         },
                                                                                             "periodSeconds":  10,
                                                                                             "successThreshold":  1,
                                                                                             "timeoutSeconds":  1
                                                                                         },
                                                                      "resources":  {
                                                                                        "limits":  {
                                                                                                       "cpu":  "500m",
                                                                                                       "memory":  "512Mi"
                                                                                                   },
                                                                                        "requests":  {
                                                                                                         "cpu":  "100m",
                                                                                                         "memory":  "192Mi"
                                                                                                     }
                                                                                    },
                                                                      "securityContext":  {
                                                                                              "allowPrivilegeEscalation":  false,
                                                                                              "capabilities":  {
                                                                                                                   "drop":  [
                                                                                                                                "ALL"
                                                                                                                            ]
                                                                                                               },
                                                                                              "readOnlyRootFilesystem":  true
                                                                                          },
                                                                      "startupProbe":  {
                                                                                           "failureThreshold":  30,
                                                                                           "httpGet":  {
                                                                                                           "path":  "/healthz",
                                                                                                           "port":  8000,
                                                                                                           "scheme":  "HTTP"
                                                                                                       },
                                                                                           "periodSeconds":  2,
                                                                                           "successThreshold":  1,
                                                                                           "timeoutSeconds":  1
                                                                                       },
                                                                      "terminationMessagePath":  "/dev/termination-log",
                                                                      "terminationMessagePolicy":  "File",
                                                                      "volumeMounts":  [
                                                                                           {
                                                                                               "mountPath":  "/traces",
                                                                                               "name":  "traces"
                                                                                           },
                                                                                           {
                                                                                               "mountPath":  "/tmp",
                                                                                               "name":  "tmp"
                                                                                           }
                                                                                       ]
                                                                  }
                                                              ],
                                               "dnsPolicy":  "ClusterFirst",
                                               "enableServiceLinks":  false,
                                               "restartPolicy":  "Always",
                                               "schedulerName":  "default-scheduler",
                                               "securityContext":  {
                                                                       "fsGroup":  10001,
                                                                       "runAsGroup":  10001,
                                                                       "runAsNonRoot":  true,
                                                                       "runAsUser":  10001,
                                                                       "seccompProfile":  {
                                                                                              "type":  "RuntimeDefault"
                                                                                          }
                                                                   },
                                               "serviceAccount":  "rahbar-api",
                                               "serviceAccountName":  "rahbar-api",
                                               "terminationGracePeriodSeconds":  30,
                                               "volumes":  [
                                                               {
                                                                   "name":  "traces",
                                                                   "persistentVolumeClaim":  {
                                                                                                 "claimName":  "rahbar-traces"
                                                                                             }
                                                               },
                                                               {
                                                                   "emptyDir":  {

                                                                                },
                                                                   "name":  "tmp"
                                                               }
                                                           ]
                                           }
                              }
             }
}
